{
  "name": "neopos-desktop",
  "productName": "NeoPos Kassa",
  "version": "0.1.0",
  "description": "NeoPos — kassa uchun Windows ilovasi",
  "author": "NeoPos",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "dist": "electron-builder --win nsis-web --publish never"
  },
  "build": {
    "appId": "uz.neopos.kassa",
    "productName": "NeoPos Kassa",
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis-web",
      "icon": "build/icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "Sariofficial23",
      "repo": "Neopos",
      "releaseType": "release"
    },
    "nsisWeb": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NeoPos Kassa",
      "runAfterFinish": true,
      "artifactName": "NeoPos-Setup.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
