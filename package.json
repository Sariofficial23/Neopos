{
  "name": "neopos",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "panel",
    "terminal"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:panel": "npm run dev -w panel",
    "db:generate": "npm run db:generate -w server",
    "seed": "npm run seed -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w panel && npm run typecheck -w terminal",
    "dev:terminal": "npm run dev -w terminal"
  }
}
